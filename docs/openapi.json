  "components": {
    "schemas": {
      "AnswerIn": {
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 2,
            "title": "Answer"
          },
          "monthly_revenue": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Monthly Revenue"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "AnswerIn"
      },
      "DraftIn": {
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "TURNOVER",
              "DEVELOPMENT",
              "CASH_GAP",
              "UNKNOWN"
            ],
            "title": "Purpose"
          },
          "product_code": {
            "type": "string",
            "title": "Product Code"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "term_months": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Term Months"
          }
        },
        "type": "object",
        "required": [
          "purpose",
          "product_code",
          "amount",
          "term_months"
        ],
        "title": "DraftIn"
      },
      "DraftPatch": {
        "properties": {
          "inn": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inn"
          },
          "legal_form": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "OOO",
                  "IP"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Legal Form"
          },
          "company_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Name"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "term_months": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Term Months"
          },
          "purpose": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "TURNOVER",
                  "DEVELOPMENT",
                  "CASH_GAP",
                  "UNKNOWN"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Purpose"
          },
          "product_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Code"
          },
          "monthly_revenue": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Monthly Revenue"
          },
          "monthly_expenses": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
